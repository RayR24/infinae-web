---
// src/pages/404.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import Footer from "../components/Footer.astro";

const description =
  "The page you are looking for does not exist or has been moved.";
---

<BaseLayout title="Page Not Found" description={description}>
  <PrimaryNav />

  <main id="main" class="page">
    <section class="hero" aria-labelledby="notfound-title">
      <div class="hero__inner">
        <p class="eyebrow">Page Not Found</p>
        <h1 id="notfound-title" class="hero__title">
          404
        </h1>
        <p class="hero__lede">
          The page you are looking for does not exist or has been moved.
        </p>
        <div class="hero__cta">
          <a href="/" class="btn btn--primary">Back to Home</a>
          <a href="/experiences" class="btn btn--outline">Explore Experiences</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    background: var(--paper);
    color: var(--ink);
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }

  .hero {
    display: grid;
    place-items: center;
    padding: 9rem 2rem 4rem;
    text-align: center;
  }

  .hero__inner {
    max-width: 46rem;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(4rem, 12vw, 8rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
    color: var(--accent);
  }

  .hero__lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.5;
    max-width: 52ch;
    margin: 0 auto 2.5rem;
    opacity: 0.85;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 7rem 1.5rem 3rem;
    }
  }
</style>
