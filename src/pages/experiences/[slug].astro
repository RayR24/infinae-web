---
// src/pages/experiences/[slug].astro
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PrimaryNav from "../../components/PrimaryNav.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const experiences = await getCollection("experiences", ({ data }) => !data.draft);
  return experiences.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"experiences">;
}

const { entry } = Astro.props;
const {
  title,
  description,
  date,
  location,
  status,
  coverImage,
  registrationUrl,
  instagramUrl,
  series,
} = entry.data;

const { Content } = await render(entry);

const formattedDate = date.toLocaleDateString("en-ZA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const isUpcoming = status === "upcoming";
---
