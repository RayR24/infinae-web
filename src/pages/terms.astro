---
// src/pages/terms.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import Footer from "../components/Footer.astro";

const description =
  "Terms and Conditions for Infinae, a culinary experience studio based in Johannesburg.";

const sections = [
  {
    heading: "Use of site",
    body: "This site provides information about Infinae and allows you to submit enquiries and requests for access.",
  },
  {
    heading: "Selectivity",
    body: "Infinae is selective. Submitting a request does not guarantee acceptance, access, or availability.",
  },
  {
    heading: "Accuracy",
    body: "You agree to provide accurate information when submitting forms.",
  },
  {
    heading: "Communications",
    body: "By submitting an enquiry, you consent to being contacted regarding your submission.",
  },
  {
    heading: "Intellectual property",
    body: "All site content, brand elements, and materials remain the property of Infinae unless stated otherwise.",
  },
];
---

<BaseLayout title="Terms and Conditions" description={description}>
  <PrimaryNav />

  <main id="main" class="page">
    <!-- HEADER -->
    <header class="header">
      <p class="eyebrow">Legal</p>
      <h1 class="header__title">Terms and<br /><em>Conditions.</em></h1>
      <p class="header__lede">Last updated: 15 February 2026</p>
    </header>

    <!-- CONTENT -->
    <section class="section" aria-label="Terms">
      <div class="section__inner">
        {sections.map((s) => (
          <article class="legal">
            <h2 class="legal__heading">{s.heading}</h2>
            <p class="legal__body">{s.body}</p>
          </article>
        ))}

        <article class="legal">
          <h2 class="legal__heading">Contact</h2>
          <p class="legal__body">
            For questions, contact{" "}
            <a href="mailto:support@infinae.co.za" class="legal__link">
              support@infinae.co.za
            </a>
            .
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    background: var(--paper);
    color: var(--ink);
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }

  /* ---------- HEADER ---------- */
  .header {
    padding: 9rem 2rem 4rem;
    text-align: center;
    border-bottom: 1px solid var(--rule);
  }

  .header__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .header__title em {
    font-style: italic;
    color: var(--accent);
  }

  .header__lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    opacity: 0.7;
    margin: 0 auto;
  }

  /* ---------- SECTIONS ---------- */
  .section {
    padding: 5rem 2rem;
  }

  .section__inner {
    max-width: 44rem;
    margin: 0 auto;
  }

  .legal {
    margin-bottom: 3rem;
  }

  .legal:last-child {
    margin-bottom: 0;
  }

  .legal__heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .legal__body {
    font-size: 1.05rem;
    line-height: 1.7;
    opacity: 0.85;
    margin: 0;
  }

  .legal__link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .legal__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 600px) {
    .header {
      padding: 7rem 1.5rem 3rem;
    }

    .section {
      padding: 4rem 1.5rem;
    }
  }
</style>
