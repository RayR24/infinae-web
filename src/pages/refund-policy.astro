---
// src/pages/refund-policy.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import Footer from "../components/Footer.astro";

const description =
  "Refund Policy for Infinae, covering advisory services, experiences and events.";

const sections = [
  {
    heading: "Advisory and Experiences",
    blocks: [
      {
        title: "Cancellation within 48 hours of booking",
        body: "If you cancel your booking at least 48 hours before the scheduled start time, you will receive a full refund minus a 10% administration fee to cover processing and administrative costs.",
      },
      {
        title: "Cancellation within 24 hours of booking",
        body: "If you cancel within 24 hours of the scheduled start time, no refund will be issued. This includes no-shows and late arrivals.",
      },
    ],
  },
  {
    heading: "Experiences",
    blocks: [
      {
        title: "Refund terms vary by experience",
        body: "Refund terms for each experience depend on the venue, chef, producer and partners involved. The specific refund conditions for an experience will be confirmed at the time of booking and may differ from the standard terms above.",
      },
      {
        title: "Confirming your terms",
        body: "Before confirming a booking, we will share the refund terms that apply to that specific experience in writing. Please review them before booking.",
      },
    ],
  },
];
---

<BaseLayout title="Refund Policy" description={description}>
  <PrimaryNav />

  <main id="main" class="page">
    <!-- HEADER -->
    <header class="header">
      <p class="eyebrow">Legal</p>
      <h1 class="header__title">Refund<br /><em>Policy.</em></h1>
      <p class="header__lede">Last updated: March 2026</p>
    </header>

    <!-- CONTENT -->
    <section class="section" aria-label="Refund Policy">
      <div class="section__inner">
        {sections.map((section) => (
          <div class="policy-group">
            <h2 class="policy-heading">{section.heading}</h2>

            {section.blocks.map((block) => (
              <article class="policy">
                <h3 class="policy__title">{block.title}</h3>
                <p class="policy__body">{block.body}</p>
              </article>
            ))}
          </div>
        ))}

        <article class="legal">
          <h2 class="legal__heading">Submitting a request</h2>
          <p class="legal__body">
            All refund requests must be submitted in writing to{" "}
            <a href="mailto:support@infinae.co.za" class="legal__link">
              support@infinae.co.za
            </a>
            .
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    background: var(--paper);
    color: var(--ink);
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }

  /* ---------- HEADER ---------- */
  .header {
    padding: 9rem 2rem 4rem;
    text-align: center;
    border-bottom: 1px solid var(--rule);
  }

  .header__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .header__title em {
    font-style: italic;
    color: var(--accent);
  }

  .header__lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    opacity: 0.7;
    margin: 0 auto;
  }

  /* ---------- SECTIONS ---------- */
  .section {
    padding: 5rem 2rem;
  }

  .section__inner {
    max-width: 44rem;
    margin: 0 auto;
  }

  .policy-group {
    margin-bottom: 4rem;
  }

  .policy-group:last-of-type {
    margin-bottom: 3rem;
  }

  .policy-heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.5vw, 1.9rem);
    line-height: 1.25;
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .policy {
    margin-bottom: 1.75rem;
    padding: 1.5rem 1.75rem;
    background: var(--paper-deep);
    border: 1px solid var(--rule);
  }

  .policy:last-child {
    margin-bottom: 0;
  }

  .policy__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.15rem;
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }

  .policy__body {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.88;
    margin: 0;
  }

  .legal {
    margin-top: 3rem;
  }

  .legal__heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .legal__body {
    font-size: 1.05rem;
    line-height: 1.7;
    opacity: 0.85;
    margin: 0;
  }

  .legal__link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .legal__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 600px) {
    .header {
      padding: 7rem 1.5rem 3rem;
    }

    .section {
      padding: 4rem 1.5rem;
    }

    .policy {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
