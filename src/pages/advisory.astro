---
// src/pages/advisory.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import Footer from "../components/Footer.astro";

const description =
  "Strategic advisory for luxury hospitality and institutional businesses. Selective engagements only. Begin with a consultation.";
---

<BaseLayout title="Advisory" description={description}>
  <PrimaryNav />

  <main id="main" class="page">
    <!-- HEADER -->
    <header class="header">
      <p class="eyebrow">Advisory</p>
      <h1 class="header__title">
        Strategic clarity for businesses<br />that value <em>identity</em>.
      </h1>
      <p class="header__lede">
        Every engagement begins with a consultation. We listen first,
        then recommend only what will move the operation forward.
      </p>
      <div class="header__cta">
        <a href="#intake" class="btn btn--primary">Request a consultation</a>
      </div>
    </header>

    <!-- WHAT WE SOLVE -->
    <section class="section" aria-labelledby="solve-title">
      <div class="section__inner">
        <header class="section__head">
          <h2 id="solve-title" class="section__title">What we solve</h2>
        </header>

        <div class="solves">
          <article class="solve">
            <span class="solve__num">i.</span>
            <div class="solve__body">
              <h3 class="solve__title">Operational inefficiency</h3>
              <p class="solve__text">
                We identify where systems are wasting time, money, and resources to redesign for clarity and consistency.
              </p>
            </div>
          </article>

          <article class="solve">
            <span class="solve__num">ii.</span>
            <div class="solve__body">
              <h3 class="solve__title">Inconsistent quality</h3>
              <p class="solve__text">
                Standards drift when no structure holds them in place. We build the systems that make excellence the default.
              </p>
            </div>
          </article>

          <article class="solve">
            <span class="solve__num">iii.</span>
            <div class="solve__body">
              <h3 class="solve__title">Misaligned values</h3>
              <p class="solve__text">
                What an institution feeds its guests and how communicates more about its values than any brand statement.
              </p>
            </div>
          </article>

          <article class="solve">
            <span class="solve__num">iv.</span>
            <div class="solve__body">
              <h3 class="solve__title">Long-term cost pressure</h3>
              <p class="solve__text">
                We design nourishment systems that reduce waste, improve efficiency, and lower operational costs over time.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- WHAT YOU CAN EXPECT -->
    <section class="section section--alt" aria-labelledby="expect-title">
      <div class="section__inner">
        <header class="section__head">
          <h2 id="expect-title" class="section__title">What you can expect</h2>
        </header>

        <div class="prose">
          <p>Greater alignment between your brand and your operation.</p>
          <p>Improved service consistency across every guest touchpoint.</p>
          <p>Stronger financial performance through deliberate positioning.</p>
          <p class="prose__accent">
            A business that feels coherent - designed, not assembled.
          </p>
        </div>
      </div>
    </section>

    <!-- SELECTIVE ENGAGEMENT -->
    <section class="section" aria-labelledby="selective-title">
      <div class="section__inner">
        <header class="section__head">
          <h2 id="selective-title" class="section__title">Selective engagement</h2>
        </header>

        <div class="prose">
          <p>Infinae works with a limited number of partners each season.</p>
          <p>We do not take on every enquiry. The intake conversation is where we decide together whether the work is a fit.</p>
        </div>
      </div>
    </section>

    <!-- INTAKE CTA -->
    <section class="cta" id="intake" aria-labelledby="intake-title">
      <div class="cta__inner">
        <p class="eyebrow">Begin with a consultation</p>
        <h2 id="intake-title" class="cta__title">
          Every advisory engagement begins with a conversation.
        </h2>
        <p class="cta__body">
          Share a little about your business and we'll be in touch
          within two working days to schedule a consultation.
        </p>
        <a href="mailto:hello@infinae.co.za" class="btn btn--light">
          Request Consultation
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    background: var(--paper);
    color: var(--ink);
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }

  /* ---------- HEADER ---------- */
  .header {
    padding: 9rem 2rem 4rem;
    text-align: center;
    border-bottom: 1px solid var(--rule);
  }

  .header__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
    max-width: 22ch;
    margin-left: auto;
    margin-right: auto;
  }

  .header__title em {
    font-style: italic;
    color: var(--accent);
  }

  .header__lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    max-width: 50ch;
    margin: 0 auto 2.5rem;
    opacity: 0.85;
  }

  .header__cta {
    display: flex;
    justify-content: center;
  }

  /* ---------- GENERIC SECTIONS ---------- */
  .section {
    padding: 6rem 2rem;
  }

  .section--alt {
    background: var(--paper-deep);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .section__inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .section__head {
    max-width: 44rem;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .section__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.2;
    margin: 0;
  }

  .prose {
    max-width: 44rem;
    margin: 0 auto;
    text-align: center;
  }

  .prose p {
    font-size: 1.05rem;
    margin: 0 0 1.25rem;
    opacity: 0.85;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .prose__accent {
    font-family: var(--serif);
    font-style: italic;
    color: var(--accent);
    opacity: 1;
    margin-top: 1.75rem;
    font-size: 1.15rem;
  }

  /* ---------- SOLVES ---------- */
  .solves {
    max-width: 48rem;
    margin: 0 auto;
  }

  .solve {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .solve:last-child {
    border-bottom: none;
  }

  .solve__num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--accent);
  }

  .solve__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  .solve__text {
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
    opacity: 0.85;
  }

  /* ---------- CTA (dark) ---------- */
  .cta {
    background: var(--ink);
    color: var(--paper);
    padding: 6rem 2rem;
    text-align: center;
  }

  .cta__inner {
    max-width: 42rem;
    margin: 0 auto;
  }

  .cta .eyebrow {
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .cta__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .cta__body {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.55;
    opacity: 0.85;
    margin: 0 0 2.5rem;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 600px) {
    .header {
      padding: 7rem 1.5rem 3rem;
    }

    .section,
    .cta {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .solve {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .solve__num {
      display: block;
      margin-bottom: 0.25rem;
    }
  }
</style>
