---
// src/components/PrimaryNav.astro
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname === path || pathname.startsWith(`${path}/`);
};

// Mobile: grouped nav. Desktop: flat nav.
const links = [
  { href: "/about", label: "About", short: "About" },
  { href: "/experiences", label: "Experiences", short: "Experiences" },
  { href: "/private-corporate", label: "Private & Corporate", short: "Private" },
  { href: "/advisory", label: "Advisory", short: "Advisory" },
  { href: "/bespoke-etiquette", label: "Bespoke Etiquette", short: "Etiquette" },
];

const services = [
  { href: "/advisory", label: "Advisory" },
  { href: "/private-corporate", label: "Private & Corporate" },
  { href: "/bespoke-etiquette", label: "Bespoke Etiquette" },
];

const isServiceActive = services.some((s) => isActive(s.href));

const contactHref = "/contact";
---

<header class="nav" id="primaryNav">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Infinae home">
      <img src="/images/logo.png" alt="Infinae" class="nav__logo" />
    </a>

    <button
      class="nav__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navMenu"
      id="navToggle"
    >
      <span></span><span></span>
    </button>

    <!-- DESKTOP MENU (flat, unchanged) -->
    <nav class="nav__menu nav__menu--desktop" aria-label="Primary">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class={`nav__link ${isActive(href) ? "nav__link--active" : ""}`}
          aria-current={isActive(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))}
      <a href={contactHref} class="nav__cta">Contact</a>
    </nav>

    <!-- MOBILE MENU (grouped) -->
    <nav class="nav__menu nav__menu--mobile" id="navMenu" aria-label="Primary mobile">
      <a href="/about" class="nav__link">About</a>
      <a href="/experiences" class="nav__link">Experiences</a>

      <details class="nav__group">
        <summary class={`nav__link nav__summary ${isServiceActive ? "nav__link--active" : ""}`}>
          Services
          <svg class="nav__chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M1 3 L5 7 L9 3" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </summary>
        <div class="nav__children">
          {services.map(({ href, label }) => (
            <a
              href={href}
              class={`nav__link nav__link--child ${isActive(href) ? "nav__link--active" : ""}`}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </details>

      <a href={contactHref} class="nav__cta">Contact</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("navToggle") as HTMLButtonElement | null;
  const menu = document.getElementById("navMenu");
  const navEl = document.getElementById("primaryNav");

  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle("nav__menu--open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.classList.toggle("nav-locked", open);
  };

  toggle?.addEventListener("click", () => {
    setOpen(!menu?.classList.contains("nav__menu--open"));
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false))
  );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 860) setOpen(false);
  });

  const onScroll = () => {
    if (window.scrollY > 40) navEl?.classList.add("nav--scrolled");
    else navEl?.classList.remove("nav--scrolled");
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(246, 241, 232, 0);
    backdrop-filter: blur(0);
    transition:
      background 0.4s ease,
      backdrop-filter 0.4s ease,
      padding 0.4s ease,
      border-color 0.4s ease;
    border-bottom: 1px solid transparent;
  }

  .nav--scrolled {
    background: rgba(246, 241, 232, 0.92);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--rule);
  }

  .nav__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: padding 0.4s ease;
  }

  .nav--scrolled .nav__inner {
    padding: 1rem 2rem;
  }

  .nav__brand {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .nav__logo {
    height: 32px;
    width: auto;
    display: block;
  }

  /* Base menu (desktop) */
  .nav__menu {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav__link {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .nav__link:hover {
    border-bottom-color: var(--ink);
  }

  .nav__link--active {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }

  .nav__cta {
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.7rem 1.35rem;
    background: var(--ink);
    color: var(--paper);
    margin-left: 0.5rem;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .nav__cta:hover {
    background: var(--accent);
    color: var(--ink);
  }

  /* Mobile menu hidden by default */
  .nav__menu--mobile {
    display: none;
  }

  /* Mobile toggle */
  .nav__toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    width: 32px;
    height: 32px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 0;
    z-index: 2;
  }

  .nav__toggle span {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--ink);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .nav__toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ---------- MOBILE ---------- */
  @media (max-width: 860px) {
    .nav__toggle {
      display: flex;
    }

    .nav__logo {
      height: 28px;
    }

    .nav__menu--desktop {
      display: none;
    }

    .nav__menu--mobile {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      padding: 0.5rem 1.5rem 1.5rem;
      max-height: calc(100vh - 72px);
      overflow-y: auto;
      transform: translateY(-10px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.35s ease, opacity 0.35s ease;
    }

    .nav__menu--mobile.nav__menu--open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .nav__link {
      width: 100%;
      padding: 1.1rem 0;
      border-bottom: 1px solid var(--rule);
      font-size: 0.9rem;
      letter-spacing: 0.12em;
      text-align: left;
    }

    /* Accordion group */
    .nav__group {
      border-bottom: 1px solid var(--rule);
    }

    .nav__group[open] .nav__summary {
      color: var(--accent);
    }

    .nav__summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 1.1rem 0;
      list-style: none;
      cursor: pointer;
      border-bottom: none;
    }

    .nav__summary::-webkit-details-marker {
      display: none;
    }

    .nav__chevron {
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }

    .nav__group[open] .nav__chevron {
      transform: rotate(180deg);
    }

    .nav__children {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0 0 0.5rem 0;
    }

    .nav__link--child {
      font-size: 0.82rem;
      letter-spacing: 0.1em;
      padding: 0.9rem 0 0.9rem 1rem;
      border-bottom: 1px solid var(--rule);
      opacity: 0.85;
    }

    .nav__link--child:last-child {
      border-bottom: none;
    }

    .nav__link--child:hover {
      opacity: 1;
      color: var(--accent);
    }

    .nav__cta {
      width: 100%;
      text-align: center;
      margin: 1.25rem 0 0;
      padding: 1rem 1.5rem;
      font-size: 0.85rem;
    }
  }

  :global(body.nav-locked) {
    overflow: hidden;
  }
</style>
