---
// src/layouts/BaseLayout.astro
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/images/og-default.jpg",
  type = "website",
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://www.infinae.co.za");
const ogImage = new URL(image, Astro.site ?? "https://www.infinae.co.za");
---

<!doctype html>
<html lang="en">
  <head>
    <!-- …all your existing meta tags… -->

    <!-- Organization JSON-LD (already there) -->
    <script type="application/ld+json" set:html={JSON.stringify({ /* …existing organization… */ })} />

    <!-- Optional per-page structured data -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- …fonts etc… -->
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
